# ==========================================
# DATABASE CONFIGURATION
# ==========================================
ATLASDB_URL=mongodb://127.0.0.1:27017/vanderlust
# For production, use MongoDB Atlas:
# ATLASDB_URL=mongodb+srv://username:password@cluster.mongodb.net/vanderlust

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=8080
NODE_ENV=development
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ==========================================
# CLOUDINARY (Image Storage)
# ==========================================
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# ==========================================
# MAPBOX (Maps & Geolocation)
# ==========================================
MAPBOX_TOKEN=your_mapbox_public_token

# ==========================================
# RAZORPAY (Payment Gateway)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# EMAIL CONFIGURATION (Gmail)
# ==========================================
# To use Gmail, generate an App Password:
# 1. Enable 2FA on your Google Account
# 2. Go to myaccount.google.com/apppasswords
# 3. Select Mail and Windows Computer
# 4. Copy the generated password below
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ==========================================
# AI FEATURES (Optional)
# ==========================================
# For Cohere API (Listing descriptions & review summaries)
COHERE_API_KEY=your_cohere_api_key
COHERE_MODEL=command-a-03-2025

# For Groq API (Chatbot)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
