<% layout("/../layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-10 offset-1">
        <h3><i class="fa-solid fa-envelope"></i> Messages</h3>
        <hr>

        <% if (conversations.length === 0) { %>
            <div class="text-center py-5">
                <i class="fa-regular fa-comments" style="font-size:4rem;color:#ccc;"></i>
                <p class="text-muted mt-3">No messages yet. Start a conversation by messaging a host from any listing page.</p>
                <a href="/listings" class="btn btn-dark mt-2">Browse Listings</a>
            </div>
        <% } else { %>
            <div class="list-group">
                <% for (let conv of conversations) { %>
                    <a href="/messages/<%= conv.conversationId %>" class="list-group-item list-group-item-action d-flex align-items-center py-3 <%= conv.unreadCount > 0 ? 'list-group-item-light' : '' %>">
                        <% if (conv.listing && conv.listing.image) { %>
                            <img src="<%= conv.listing.image.url %>" alt="" style="width:56px;height:56px;object-fit:cover;border-radius:8px;" class="me-3">
                        <% } else { %>
                            <div class="me-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#eee;border-radius:8px;">
                                <i class="fa-solid fa-image text-muted"></i>
                            </div>
                        <% } %>

                        <div class="flex-grow-1 overflow-hidden">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong style="font-size:0.95rem;">
                                    <%= conv.otherUser ? conv.otherUser.username : "Deleted User" %>
                                </strong>
                                <small class="text-muted">
                                    <%= conv.lastMessage.createdAt.toLocaleDateString("en-IN", { day:"numeric", month:"short" }) %>
                                </small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted text-truncate" style="max-width:80%;">
                                    <% if (conv.listing) { %><%= conv.listing.title %> &mdash; <% } %>
                                    <%= conv.lastMessage.content.substring(0, 80) %><%= conv.lastMessage.content.length > 80 ? "..." : "" %>
                                </small>
                                <% if (conv.unreadCount > 0) { %>
                                    <span class="badge bg-danger rounded-pill"><%= conv.unreadCount %></span>
                                <% } %>
                            </div>
                        </div>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
