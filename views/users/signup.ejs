<% layout("/../layouts/boilerplate") %>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fa-solid fa-compass"></i>
            <span>Wanderlust</span>
        </div>
        <h2 class="auth-title">Create an account</h2>
        <p class="auth-subtitle">Join thousands of travellers on Wanderlust</p>
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" name="username" class="form-control" id="username" placeholder="Choose a username" required>
                <div class="valid-feedback">Looks good!</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" name="email" class="form-control" id="email" placeholder="you@example.com" required>
            </div>
            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" class="form-control" id="password" placeholder="Create a password" required>
            </div>
            <button class="btn btn-auth">Sign Up</button>
        </form>
        <p class="text-center mt-3 mb-0" style="font-size:0.88rem; color:#999;">
            Already have an account? <a href="/login">Log in</a>
        </p>
    </div>
</div>