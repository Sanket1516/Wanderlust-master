<!-- applying the ejs mate boilerplate to this file -->
<% layout("/../layouts/boilerplate") %>
<body>
    <script>
        const mapToken = '<%= process.env.MAPBOX_TOKEN %>';
        const coordinates = <%-JSON.stringify(data.geometry.coordinates) %>;
    </script>
    <div class="row mt-3">
        <!-- d-flex + align-items-center + gap-3 = puts the title and heart button side by side with space between -->
        <div class="col-8 offset-3 d-flex align-items-center gap-3">
    <h3 class="mb-0"><%=data.title%></h3>

    <!-- Only show the Save/Saved button if the user is logged in -->
    <% if(currUser) { %>
    <%
        // Check if this listing is already in the logged-in user's wishlist.
        // wishlistSet is a Set of stringified ObjectIds passed from controller/listings.js.
        // .has() returns true (show "Saved" button) or false (show "Save" button).
        const isWishlisted = wishlistSet.has(data._id.toString());
    %>
    <!-- Use a regular form POST (not AJAX) for the show page - simpler approach,
         page will reload after toggling which refreshes the button state automatically -->
    <form action="/wishlist/<%= data._id %>/toggle" method="POST" class="d-inline">
        <button type="submit"
            <% /* Change button style based on wishlist state: filled danger = saved, outline = not saved */ %>
            class="btn btn-sm <%= isWishlisted ? 'btn-danger' : 'btn-outline-danger' %>"
            title="<%= isWishlisted ? 'Remove from wishlist' : 'Save to wishlist' %>">
            <!-- Solid heart icon if saved, outline if not -->
            <i class="<%= isWishlisted ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
            <%= isWishlisted ? 'Saved' : 'Save' %>
        </button>
    </form>
    <% } %>
    </div>
    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%=data.image.url%>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text">
               Owned by <i><%= data.owner.username %></i>
            </p>
            <p class="card-text">
                <%=data.description%><br>
            </p>
            <p class="card-text">
                &#8377; <%=data.price.toLocaleString("en-IN")%><br>
            </p>
             <p class="card-text">
                <%=data.location%><br>
            </p>
             <p class="card-text">
                <%=data.country%>
            </p>
        </div>
    </div>

    <!-- There Must be the curr user and if he exists then check equals to   -->

         <div class="btns">
        <a href="/listings/<%=data._id%>/edit" class="btn btn-dark col-1 offset-3">Edit</a>  
        <form method="post" action="/listings/<%=data._id%>?_method=DELETE">
            <button class="btn btn-danger offset-5"> Delete </button>
        </form>
    </div>


   
    <div class="col-8 offset-3 mt-3">
    </div>
    <div class="col-8 offset-3">
        <hr>
         <% if(currUser){ %>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= data._id %>/reviews" method="post" class="mb-3 mt-3 needs-validation"  novalidate >
            <!-- <div class="mb-3 mt-3">
             
                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
            </div> -->
             <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            </div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                <div class="invalid-feedback">Please add some comments for the review</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <% } %>

        <% if(data.reviews.length > 0){ %>
        <div class="row">
        <p><b>All Reviews</b></p>
         <% for(review of data.reviews) { %>
            <div class="card col-5 ms-3 mb-3">
                <div class="card-body">
                    <!-- we have print here -->
                     <h5 class="card-title">@<%= review.author.username %></h5>
                      <p class="starability-result card-text" data-rating="<%= review.rating %>">
                        Rated: <%= review.rating %> stars
                    </p>
                      <p class="card-text"><%= review.comment %></p>
                   
                </div>
                <!-- Created a new type of api like deleting a particular review from the particular listing -->
                <form class="mb-3" method="post" action="/listings/<%= data._id %>/reviews/<%= review._id %>?_method=DELETE"> 
                    <button class="btn btn-sm btn-dark">Delete</button>
                </form>
            </div>
         <% } %>
         </div>
         <% }  %>
    </div>
            <div class="col-8 offset-3 mb-3">
            <h3>Where you can find this place</h3>
            <div id="map">
            </div>
    </div>
    <script src="/js/map.js"></script>
</body>
