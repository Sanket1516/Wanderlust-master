<% layout("/../layouts/boilerplate") %>

<body>

<!-- CATEGORY FILTER BAR -->
<div class="filter-bar-wrap">
    <div id="filters">

        <div class="filter active" data-filter="All">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>

        <div class="filter" data-filter="Rooms">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>

        <div class="filter" data-filter="City">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>

        <div class="filter" data-filter="Mountains">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>

        <div class="filter" data-filter="Castles">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>

        <div class="filter" data-filter="Pools">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>

        <div class="filter" data-filter="Camp">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>

        <div class="filter" data-filter="Cabin">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Cabins</p>
        </div>

        <div class="filter" data-filter="Nature">
            <div><i class="fa-solid fa-tree"></i></div>
            <p>Nature</p>
        </div>

        <div class="filter" data-filter="Farm">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>

        <div class="filter" data-filter="Boat">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>Boats</p>
        </div>

        <div class="filter" data-filter="Cruise">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Cruise</p>
        </div>

        <div class="tax-toggle ms-auto">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">
                    Show taxes
                </label>
            </div>
        </div>
    </div>
</div>

<!-- ADVANCED FILTER TOOLBAR -->
<%
    const hasFilters = filters && (filters.minPrice || filters.maxPrice || filters.country || filters.sort);
%>
<div class="adv-filter-toolbar d-flex align-items-center flex-wrap gap-2 mt-3 mb-1">
    <!-- Result count -->
    <span class="result-count text-muted small">
        <% if(pagination && pagination.totalPages > 1) {
            const from = (pagination.currentPage - 1) * pagination.LIMIT + 1;
            const to   = Math.min(pagination.currentPage * pagination.LIMIT, pagination.totalCount);
        %>
        Showing <b><%= from %>–<%= to %></b> of <b><%= pagination.totalCount %></b> listing<%= pagination.totalCount !== 1 ? 's' : '' %>
        <% } else { %>
        <b><%= pagination ? pagination.totalCount : allListings.length %></b> listing<%= (pagination ? pagination.totalCount : allListings.length) !== 1 ? 's' : '' %>
        <% } %>
    </span>

    <!-- Active filter chips -->
    <% if(filters && filters.minPrice) { %>
    <span class="filter-chip">Min &#8377;<%= filters.minPrice %></span>
    <% } %>
    <% if(filters && filters.maxPrice) { %>
    <span class="filter-chip">Max &#8377;<%= filters.maxPrice %></span>
    <% } %>
    <% if(filters && filters.country) { %>
    <span class="filter-chip"><i class="fa-solid fa-location-dot me-1"></i><%= filters.country %></span>
    <% } %>
    <% if(filters && filters.sort) { %>
    <%
        const sortLabels = { price_asc: 'Price: Low-High', price_desc: 'Price: High-Low', newest: 'Newest First' };
    %>
    <span class="filter-chip"><i class="fa-solid fa-arrow-up-wide-short me-1"></i><%= sortLabels[filters.sort] || filters.sort %></span>
    <% } %>
    <% if(hasFilters) { %>
    <a href="/listings" class="filter-clear-btn">
        <i class="fa-solid fa-xmark me-1"></i>Clear all
    </a>
    <% } %>

    <button class="btn btn-sm adv-filter-toggle ms-auto <%= hasFilters ? 'active' : '' %>"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#advFilterPanel"
            aria-expanded="<%= hasFilters ? 'true' : 'false' %>">
        <i class="fa-solid fa-sliders me-1"></i>Filters<% if(hasFilters) { %> <span class="adv-filter-dot"></span><% } %>
    </button>
</div>

<!-- COLLAPSIBLE FILTER FORM -->
<div class="collapse <%= hasFilters ? 'show' : '' %>" id="advFilterPanel">
    <form action="/listings" method="GET" class="adv-filter-form">
        <div class="row g-2 align-items-end">
            <div class="col-sm-2 col-6">
                <label class="form-label small mb-1">Min Price (&#8377;)</label>
                <input type="number" name="minPrice" class="form-control form-control-sm"
                       placeholder="e.g. 1000" min="0"
                       value="<%= (filters && filters.minPrice) ? filters.minPrice : '' %>">
            </div>
            <div class="col-sm-2 col-6">
                <label class="form-label small mb-1">Max Price (&#8377;)</label>
                <input type="number" name="maxPrice" class="form-control form-control-sm"
                       placeholder="e.g. 20000" min="0"
                       value="<%= (filters && filters.maxPrice) ? filters.maxPrice : '' %>">
            </div>
            <div class="col-sm-3 col-12">
                <label class="form-label small mb-1">Country</label>
                <input type="text" name="country" class="form-control form-control-sm"
                       placeholder="e.g. India, France…"
                       value="<%= (filters && filters.country) ? filters.country : '' %>">
            </div>
            <div class="col-sm-3 col-12">
                <label class="form-label small mb-1">Sort By</label>
                <select name="sort" class="form-select form-select-sm">
                    <option value="" <%- (!filters || !filters.sort) ? 'selected' : '' %>>Default</option>
                    <option value="price_asc"  <%- (filters && filters.sort === 'price_asc')  ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="price_desc" <%- (filters && filters.sort === 'price_desc') ? 'selected' : '' %>>Price: High to Low</option>
                    <option value="newest"     <%- (filters && filters.sort === 'newest')     ? 'selected' : '' %>>Newest First</option>
                </select>
            </div>
            <div class="col-sm-2 col-12">
                <button type="submit" class="btn btn-sm btn-dark w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Apply
                </button>
            </div>
        </div>
    </form>
</div>

<!-- LISTINGS GRID -->
<div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-4 g-4">

    <% if(allListings.length === 0) { %>
    <div class="col-12 text-center py-5">
        <i class="fa-solid fa-house-circle-xmark fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-1 fw-semibold">No listings found</p>
        <p class="text-muted small mb-3">Try adjusting or clearing your filters.</p>
        <a href="/listings" class="btn btn-sm btn-outline-danger">Clear filters &amp; show all</a>
    </div>
    <% } %>

    <% for(let listing of allListings){ %>
    <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing_link">
            <div class="listing-card position-relative" data-category="<%= listing.category %>">

                <!-- Image -->
                <div class="listing-img-wrap">
                    <img src="<%= listing.image.url %>"
                         class="listing-img"
                         alt="<%= listing.title %>"
                         loading="lazy">

                    <!-- Category badge on image -->
                    <span class="listing-cat-badge"><%= listing.category %></span>

                    <!-- Wishlist heart button -->
                    <% if(currUser) { %>
                    <%
                        const isWishlisted = wishlistSet.has(listing._id.toString());
                    %>
                    <button
                        class="wish-btn"
                        data-listing-id="<%= listing._id %>"
                        data-wishlisted="<%= isWishlisted %>"
                        aria-label="Save to wishlist"
                        title="<%= isWishlisted ? 'Remove from wishlist' : 'Save to wishlist' %>">
                        <i class="<%= isWishlisted ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
                    </button>
                    <% } %>
                </div>

                <!-- Card body -->
                <div class="listing-info">
                    <div class="listing-title"><%= listing.title %></div>
                    <div class="listing-location">
                        <i class="fa-solid fa-location-dot"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </div>
                    <div class="listing-price">
                        <span class="price-amt">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                        <span class="price-unit">/ night</span>
                        <span class="taxInfo price-tax">
                            &nbsp;·&nbsp;&#8377;<%= (listing.price * 1.18).toLocaleString("en-IN") %> with taxes
                        </span>
                    </div>
                </div>

            </div>
        </a>
    </div>
    <% } %>

</div>

<!-- =====================================================================
     PAGINATION
     Only renders when there is more than one page of results.
     The `pagination` object is passed from controller/listings.js and contains:
       - currentPage  : the active page number (1-based)
       - totalPages   : total number of pages based on LIMIT and totalCount
       - totalCount   : total listings matching the current filters
       - LIMIT        : how many listings are shown per page (12)
       - pageNumbers  : pre-built array like [1, 2, 3] or [1, '...', 4, 5, 6, '...', 12]
                        computed in the controller to keep EJS logic minimal
     pagination is null on the /search route, so the whole block is safely skipped.
     ===================================================================== -->

<%# Skip the entire pagination block if pagination is null (search route) or there is only 1 page %>
<% if(pagination && pagination.totalPages > 1) { %>

<%
    // pageUrl(pageNum) — server-side helper used by every page link in this block.
    // It builds a /listings?... URL that carries forward all active filter params
    // so navigating between pages never silently drops the user's filter state.
    // URLSearchParams is a Node.js built-in (available globally since Node 10).
    function pageUrl(pageNum) {                              // accepts the target page number
        const p = new URLSearchParams();                     // start with an empty query builder
        if (filters.minPrice)  p.set("minPrice",  filters.minPrice);  // carry forward min price if set
        if (filters.maxPrice)  p.set("maxPrice",  filters.maxPrice);  // carry forward max price if set
        if (filters.country)   p.set("country",   filters.country);   // carry forward country filter if set
        if (filters.sort)      p.set("sort",       filters.sort);     // carry forward sort option if set
        if (filters.category)  p.set("category",  filters.category);  // carry forward category filter if set
        p.set("page", pageNum);                              // set the actual page number we're linking to
        return "/listings?" + p.toString();                  // return the final URL string
    }
%>

<%# Outer <nav> wrapper — gives the pagination bar semantic meaning and an accessible label %>
<nav class="pagination-wrap" aria-label="Listings pagination">

    <%# ── PREVIOUS BUTTON ──────────────────────────────────────────── %>
    <%# href points to (currentPage - 1) via pageUrl so filters are preserved %>
    <%# 'disabled' class is added when we are already on page 1 (CSS blocks clicks + fades it) %>
    <a href="<%= pageUrl(pagination.currentPage - 1) %>"
       class="page-btn page-prev <%= pagination.currentPage === 1 ? 'disabled' : '' %>"
       aria-label="Previous page">
        <i class="fa-solid fa-chevron-left"></i>  <%# left-arrow icon inside the button %>
    </a>

    <%# ── PAGE NUMBER BUTTONS ──────────────────────────────────────── %>
    <%# pagination.pageNumbers is an array of integers and "..." strings built in the controller %>
    <%# Example for 12 total pages while on page 5: [1, "...", 4, 5, 6, "...", 12] %>
    <% for(let p of pagination.pageNumbers) { %>  <%# loop over every entry in the pageNumbers array %>

        <%# If the entry is the ellipsis sentinel string, render a non-clickable dots span %>
        <% if(p === "...") { %>
        <span class="page-ellipsis">…</span>  <%# visual gap between page groups, not a link %>

        <%# Otherwise render a clickable page-number link %>
        <% } else { %>
        <a href="<%= pageUrl(p) %>"                                        <%# link to this page number, preserving filters %>
           class="page-btn <%= p === pagination.currentPage ? 'active' : '' %>"  <%# 'active' highlights the current page (dark bg, no pointer) %>
           aria-label="Page <%= p %>"                                      <%# screen-reader label %>
           aria-current="<%= p === pagination.currentPage ? 'page' : '' %>">     <%# tells screen readers which page is current %>
            <%= p %>  <%# render the page number as the button label %>
        </a>
        <% } %>

    <% } %>  <%# end of pageNumbers loop %>

    <%# ── NEXT BUTTON ──────────────────────────────────────────────── %>
    <%# href points to (currentPage + 1) via pageUrl so filters are preserved %>
    <%# 'disabled' class is added when we are already on the last page %>
    <a href="<%= pageUrl(pagination.currentPage + 1) %>"
       class="page-btn page-next <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>"
       aria-label="Next page">
        <i class="fa-solid fa-chevron-right"></i>  <%# right-arrow icon inside the button %>
    </a>

</nav>  <%# end of pagination nav %>
<% } %>  <%# end of pagination visibility check %>

<!-- TAX TOGGLE -->
<script>
    const priceSwitch = document.getElementById("switchCheckDefault");
    priceSwitch.addEventListener("click", () => {
        const taxInfoEls = document.getElementsByClassName("taxInfo");
        for (let el of taxInfoEls) {
            el.style.display = priceSwitch.checked ? "inline" : "none";
        }
    });
</script>

<!-- CATEGORY FILTER LOGIC -->
<script>
    const categoryBtns = document.querySelectorAll(".filter");
    const listingCards = document.querySelectorAll(".listing_link");

    categoryBtns.forEach(function(btn) {
        btn.addEventListener("click", function() {
            // Update active state
            categoryBtns.forEach(function(b) { b.classList.remove("active"); });
            this.classList.add("active");

            const selected = this.getAttribute("data-filter");

            listingCards.forEach(function(link) {
                const card = link.querySelector(".listing-card");
                const cat  = card.getAttribute("data-category");
                link.style.display = (selected === "All" || cat === selected) ? "" : "none";
            });
        });
    });
</script>

<!-- WISHLIST TOGGLE (AJAX) -->
<script>
    const wishlistBadge = document.getElementById("wishlist-badge");

    document.querySelectorAll(".wish-btn").forEach(function(btn) {
        btn.addEventListener("click", function(e) {
            e.preventDefault();
            e.stopPropagation();

            const listingId = this.dataset.listingId;
            const icon = this.querySelector("i");

            fetch("/wishlist/" + listingId + "/toggle", {
                method: "POST",
                headers: { "X-Requested-With": "XMLHttpRequest" },
                credentials: "same-origin"
            })
            .then(function(r) {
                if (r.redirected) { window.location.href = "/login"; return null; }
                return r.json();
            })
            .then(function(data) {
                if (!data) return;
                if (data.wishlisted) {
                    icon.classList.replace("fa-regular", "fa-solid");
                    icon.classList.add("text-danger");
                } else {
                    icon.classList.replace("fa-solid", "fa-regular");
                    icon.classList.remove("text-danger");
                }
                if (wishlistBadge) {
                    wishlistBadge.textContent = data.wishlistCount;
                    wishlistBadge.classList.toggle("d-none", data.wishlistCount === 0);
                }
            })
            .catch(function(err) { console.error("Wishlist toggle failed:", err); });
        });
    });
</script>

</body>
