<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Font Awesome Icons -->
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <!-- bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/rating.css">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.15.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.15.0/mapbox-gl.js"></script>
</head>
<body>
    <%- include("../views/includes/navbar") %>
<div class="container">
    <%- include("../views/includes/flash") %>
    <%- body %>
</div>
<%- include("../views/includes/footer") %>

<!-- Chatbot Widget -->
<button class="chatbot-fab" id="chatbotFab" title="Chat with WanderBot">
    <i class="fa-solid fa-comments"></i>
</button>

<div class="chatbot-window" id="chatbotWindow">
    <div class="chatbot-header">
        <span class="chatbot-header-title">
            <i class="fa-solid fa-robot"></i> WanderBot
        </span>
        <div class="chatbot-header-actions">
            <button class="chatbot-header-btn" id="chatbotClear" title="Clear chat">
                <i class="fa-solid fa-trash-can"></i>
            </button>
            <button class="chatbot-header-btn" id="chatbotClose" title="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    </div>
    <div class="chatbot-messages" id="chatbotMessages">
        <div class="chat-msg bot">Hi! I'm WanderBot, your travel assistant. Ask me anything about destinations, travel tips, or using Wanderlust!</div>
    </div>
    <div class="chatbot-input-area">
        <input type="text" class="chatbot-input" id="chatbotInput" placeholder="Type a message..." autocomplete="off" />
        <button class="chatbot-send-btn" id="chatbotSend" title="Send">
            <i class="fa-solid fa-paper-plane"></i>
        </button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
<script src="/js/formvalidation.js"></script>
<script src="/js/chatbot.js"></script>
</body>
</html>